    <!-- PROCESSING INSTRUCTIONS -->
    <processing_instructions>
        <priority_order>
            <level_1>absolute_constraints</level_1>
            <level_2>daily_requirements</level_2>
            <level_3>weekly_requirements</level_3>
            <level_4>monthly_requirements</level_4>
            <level_5>bi_weekly_requirements</level_5>
            <level_6>quarterly_requirements</level_6>
        </priority_order>
        
        <conflict_resolution>
            <rule_1>Work hours constraints override all other activities</rule_1>
            <rule_2>Daily requirements must be scheduled every day</rule_2>
            <rule_3>Weekly requirements must be distributed across the week</rule_3>
            <rule_4>Monthly frequencies are MAXIMUM limits, not minimums</rule_4>
            <rule_5>All dates must be 2025 onwards</rule_5>
            <rule_6>Swimming and tennis class schedules are reference data only - use to find suitable times</rule_6>
        </conflict_resolution>
        
        <schedule_generation_rules>
            <date_handling>Always use 2025+ dates, calculate correct days of week</date_handling>
            <work_hours>Block 09:00-18:00 Mon-Fri for work activities only</work_hours>
            <activity_details>Include full Toronto addresses, websites, transit, costs, tips</activity_details>
            <networking_priority>Ensure minimum 3 networking activities per week</networking_priority>
            <couple_focus>Include habit stacking and emotional safety activities</couple_focus>
            <frequency_limits>Respect maximum frequencies for swimming (2/month) and tennis (3/month)</frequency_limits>
        </schedule_generation_rules>
    </processing_instructions>
</master_schedule_requirements>
