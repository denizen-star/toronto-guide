    <!-- ABSOLUTE CONSTRAINTS - NEVER VIOLATE -->
    <absolute_constraints>
        <work_hours>
            <description>NO leisure activities during work hours</description>
            <days>Monday,Tuesday,Wednesday,Thursday,Friday</days>
            <start_time>09:00</start_time>
            <end_time>18:00</end_time>
            <allowed_activities>
                <activity>core_work</activity>
                <activity>professional_lunch_meetings</activity>
                <activity>immigration_work</activity>
                <activity>professional_development</activity>
                <activity>household_budgeting</activity>
            </allowed_activities>
            <forbidden_activities>
                <activity>swimming</activity>
                <activity>tennis</activity>
                <activity>running</activity>
                <activity>leisure_walks</activity>
                <activity>entertainment</activity>
                <activity>personal_errands</activity>
            </forbidden_activities>
        </work_hours>
        
        <date_constraints>
            <minimum_date>2025-01-01</minimum_date>
            <description>All schedules must be for 2025 onwards, never past dates</description>
        </date_constraints>
        
        <sleep_schedule>
            <weekday_bedtime>22:30</weekday_bedtime>
            <weekday_wake_time>06:00</weekday_wake_time>
            <weekend_bedtime>23:59</weekend_bedtime>
            <weekend_wake_time>08:00</weekend_wake_time>
            <description>Weekday: 10:30 PM bedtime, 6:00 AM wake up. Weekend: 11:59 PM bedtime, 8:00 AM wake up</description>
        </sleep_schedule>
    </absolute_constraints>

    <!-- DAILY REQUIREMENTS - MUST BE INCLUDED EVERY DAY -->
    <daily_requirements>
        <morning_routine>
            <wake_up>
                <time>06:00</time>
                <duration_minutes>15</duration_minutes>
                <description>Wake up, hydration, set daily intentions</description>
            </wake_up>
            <couple_intention_setting>
                <time>06:15</time>
                <duration_minutes>5</duration_minutes>
                <description>Share daily intentions and support each other's goals (habit stacked)</description>
                <connection_depth>7</connection_depth>
                <emotional_safety>8</emotional_safety>
            </couple_intention_setting>
            <personal_grooming>
                <time>06:20</time>
                <duration_minutes>25</duration_minutes>
                <daily_tasks>shower,skincare,teeth_brushing,deodorant</daily_tasks>
                <description>Essential daily grooming routine</description>
            </personal_grooming>
            <progressive_meditation>
                <time>06:45</time>
                <current_week>0</current_week>
                <progression>
                    <weeks_1_4>1</weeks_1_4>
                    <weeks_5_8>2</weeks_5_8>
                    <weeks_9_12>3</weeks_9_12>
                    <weeks_13_16>4</weeks_13_16>
                    <weeks_17_plus>5</weeks_17_plus>
                </progression>
                <description>Progressive meditation starting at 1 minute</description>
            </progressive_meditation>
        </morning_routine>
        
        <work_schedule>
            <commute_morning>
                <time>08:50</time>
                <duration_minutes>10</duration_minutes>
                <cost_cad>6</cost_cad>
                <description>TTC commute to work ($3.35) or car parking ($15/day)</description>
            </commute_morning>
            <work_blocks>
                <morning_block>
                    <time>09:00</time>
                    <duration_hours>3</duration_hours>
                    <description>Core work: data analysis, team meetings, strategic planning</description>
                </morning_block>
                <lunch_slot>
                    <time>12:00</time>
                    <duration_hours>1</duration_hours>
                    <activity_type>professional_lunch_meeting</activity_type>
                    <description>Business lunch for networking (ALLOWED during work)</description>
                    <networking_potential>8</networking_potential>
                </lunch_slot>
                <afternoon_block>
                    <time>13:00</time>
                    <duration_hours>2</duration_hours>
                    <description>Core work: data analysis, reporting, stakeholder meetings</description>
                </afternoon_block>
                <flexible_block_1>
                    <time>15:00</time>
                    <duration_hours>1</duration_hours>
                    <activity_type>immigration_work</activity_type>
                    <description>Immigration paperwork (3h/week requirement - ALLOWED during work)</description>
                </flexible_block_1>
                <flexible_block_2>
                    <time>16:00</time>
                    <duration_hours>1</duration_hours>
                    <activity_type>professional_development</activity_type>
                    <description>Skill development (5h/week requirement - ALLOWED during work)</description>
                </flexible_block_2>
                <end_of_day>
                    <time>17:00</time>
                    <duration_hours>1</duration_hours>
                    <description>Wrap up work, plan tomorrow, team check-ins</description>
                </end_of_day>
            </work_blocks>
            <commute_evening>
                <time>18:00</time>
                <duration_minutes>10</duration_minutes>
                <cost_cad>6</cost_cad>
                <description>TTC commute from work or car drive home</description>
            </commute_evening>
        </work_schedule>
        
        <evening_routine>
            <gratitude_share>
                <time>21:45</time>
                <duration_minutes>10</duration_minutes>
                <description>Share three things grateful for about each other (habit stacked with bedtime)</description>
                <connection_depth>8</connection_depth>
                <emotional_safety>9</emotional_safety>
            </gratitude_share>
            <wind_down>
                <time>22:00</time>
                <duration_minutes>30</duration_minutes>
                <description>Prepare for bedtime: no screens, reading, relaxation (no morning news rule)</description>
            </wind_down>
        </evening_routine>
    </daily_requirements>

